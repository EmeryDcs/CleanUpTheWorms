  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::S_DialogueBubbleAudio
  isFirstBubble: 1
  typingSpeed: 0.005
  isPlayingAnim: 0
  isOpening: 0
  voiceOverIndex: 0
  textFrench: 'Bonjour.

    Je suis votre robot poubelle, et je vous accompagnerais
    durant votre mission de nettoyage.

    Verifions que votre materiel fonctionne
    correctement : appuyez sur la gachette de votre pince quelque fois.'
  textEnglish: 'Hello.

    I am your trash robot, and I will accompany you during
    your cleaning mission.

    Let''s check that your equipment is working correctly:
    press the trigger on your grabber a few times.'
  textJapanese: "\u3053\u3093\u306B\u3061\u306F\u3002\n\u79C1\u306F\u3042\u306A\u305F\u306E\u30B4\u30DF\u56DE\u53CE\u30ED\u30DC\u30C3\u30C8\u3067\u3059\u3002\u6E05\u6383\u30DF\u30C3\u30B7\u30E7\u30F3\u306E\u9593\u3001\u3042\u306A\u305F\u306B\u540C\u884C\u3057\u307E\u3059\u3002\n\u6A5F\u6750\u304C\u6B63\u5E38\u306B\u52D5\u4F5C\u3059\u308B\u304B\u78BA\u8A8D\u3057\u307E\u3057\u3087\u3046\u3002\u30A2\u30FC\u30E0\u306E\u30C8\u30EA\u30AC\u30FC\u3092\u6570\u56DE\u5F15\u3044\u3066\u307F\u3066\u304F\u3060\u3055\u3044\u3002"
  japaneseFont: {fileID: 11400000, guid: 1b3b6c642f0817149a13f55d10aedaf4, type: 2}
  isSpecialUpgrade: 0
  targetLight: {fileID: 0}
  blinkInterval: 0.15
