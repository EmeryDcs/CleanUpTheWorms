  m_Script: {fileID: 11500000, guid: 12aeb0794dbdd474cbb766eb2753c727, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::S_DialogueBubbleAudio
  isFirstBubble: 0
  typingSpeed: 0.005
  isPlayingAnim: 1
  isOpening: 1
  voiceOverIndex: 5
  textFrench: Plongez votre pince ! Je crois avoir reussi a vous deverouiller une
    amelioration. On risque de croiser d'autres larves et si elle grouille partout,
    vous aurez besoin d'une allonge !
  textEnglish: Plunge your grabber in! I think I managed to unlock an upgrade for
    you. We might come across other larvae, and if they are swarming everywhere,
    you will need an extension!
  textJapanese: "\u30AF\u30ED\u30FC\u3092\u7A81\u3063\u8FBC\u3093\u3067\u304F\u3060\u3055\u3044\uFF01\u3042\u306A\u305F\u306E\u305F\u3081\u306B\u30A2\u30C3\u30D7\u30B0\u30EC\u30FC\u30C9\u3092\u89E3\u9664\u3067\u304D\u305F\u3068\u601D\u3044\u307E\u3059\u3002\u4ED6\u306B\u3082\u5E7C\u866B\u306B\u906D\u9047\u3059\u308B\u304B\u3082\u3057\u308C\u307E\u305B\u3093\u3057\u3001\u3042\u3061\u3053\u3061\u3067\u3046\u3054\u3081\u3044\u3066\u3044\u308B\u306A\u3089\u3001\u5EF6\u9577\u30AF\u30ED\u30FC\u304C\u5FC5\u8981\u306B\u306A\u308A\u307E\u3059\u3088\uFF01"
  japaneseFont: {fileID: 11400000, guid: 1b3b6c642f0817149a13f55d10aedaf4, type: 2}
  isSpecialUpgrade: 1
  targetLight: {fileID: 91055869}
  blinkInterval: 0.15
