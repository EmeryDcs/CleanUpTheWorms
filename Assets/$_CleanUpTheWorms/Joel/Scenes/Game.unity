  m_Script: {fileID: 11500000, guid: 12aeb0794dbdd474cbb766eb2753c727, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::S_DialogueBubbleAudio
  isFirstBubble: 0
  typingSpeed: 0.005
  isPlayingAnim: 1
  isOpening: 1
  voiceOverIndex: 1
  textFrench: 'Super, votre pince fonctionne correctement.

    Lorsque vous ramasserez
    un dechet, veuillez me le jeter dans mon recipient. Je l''ouvrirais lorsque vous
    aurez un dechet dans votre pince. Essayons avec le dechet derriere vous.'
  textEnglish: "Great, your grabber is working correctly.\nWhen you pick up a piece
    of trash, please throw it into my container. \nI will open it when you have a
    piece of trash in your grabber. \nLet's try with the piece of trash behind you."
  textJapanese: "\u7D20\u6674\u3089\u3057\u3044\u3001\u3042\u306A\u305F\u306E\u30A2\u30FC\u30E0\u306F\u6B63\u5E38\u306B\u52D5\u4F5C\u3057\u3066\u3044\u307E\u3059\u3002\n\u30B4\u30DF\u3092\u62FE\u3063\u305F\u3089\u3001\u79C1\u306E\u30B3\u30F3\u30C6\u30CA\u306B\u6295\u3052\u5165\u308C\u3066\u304F\u3060\u3055\u3044\u3002\u30A2\u30FC\u30E0\u3067\u30B4\u30DF\u3092\u63B4\u3080\u3068\u30B3\u30F3\u30C6\u30CA\u304C\u958B\u304D\u307E\u3059\u3002\u5F8C\u308D\u306B\u3042\u308B\u30B4\u30DF\u3067\u8A66\u3057\u3066\u307F\u307E\u3057\u3087\u3046\u3002"
  japaneseFont: {fileID: 11400000, guid: 1b3b6c642f0817149a13f55d10aedaf4, type: 2}
  isSpecialUpgrade: 0
  targetLight: {fileID: 0}
  blinkInterval: 0.15
